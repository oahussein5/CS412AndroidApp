<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvFullName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Full Name: Jane Doe"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvStudentId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Student ID: 000000000"
        android:textSize="18sp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnStartExplicit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Activity Explicitly"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnStartImplicit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Activity Implicitly" />

</LinearLayout>